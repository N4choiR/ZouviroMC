{
  "name": "minicode",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/core"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@minicode/web",
    "dev:web": "npm run dev --workspace=@minicode/web",
